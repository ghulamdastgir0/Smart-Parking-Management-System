datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  CUSTOMER
}

enum SlotType {
  STANDARD
  LARGE
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum ReservationStatus {
  CONFIRMED // Reservation made, no payment collected yet; check-in QR issued
  CHECKED_IN // Vehicle checked in; slot OCCUPIED
  OVERTIME // Grace period expired with another reservation queued; flagged for staff
  PENDING_PAYMENT // Checkout QR scanned, charge computed, awaiting dummy payment
  COMPLETED // Checkout payment succeeded; slot released
  CANCELLED // Auto-cancelled: no check-in within the check-in grace window
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum QrCodeType {
  CHECK_IN
  CHECK_OUT
}

enum QrCodeStatus {
  ACTIVE
  USED
  EXPIRED
}

enum ChallanType {
  EXTENSION // Automatic 1-hour extension because no other reservation is queued
  OVERTIME // Grace period expired while another reservation is queued for the slot
}

enum NotificationRecipientRole {
  USER
  MANAGER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String // Bcrypt hash
  firstName    String
  lastName     String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  managedLots  ParkingLot[]  @relation("ManagerLots")
  reservations Reservation[]

  @@index([email])
}

model ParkingLot {
  id          String         @id @default(uuid())
  name        String
  address     String
  latitude    Float // For Leaflet / OpenStreetMap searches
  longitude   Float
  managerId   String
  rows        Int // Parking layout: number of row bands (A, B, C, ...)
  columns     Int // Parking layout: slots per row (1..columns)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  manager       User           @relation("ManagerLots", fields: [managerId], references: [id])
  slots         ParkingSlot[]
  reservations  Reservation[]
  occupancyLogs OccupancyLog[]

  @@index([latitude, longitude]) // Fast geospatial bounds filtering
}

model ParkingSlot {
  id           String        @id @default(uuid())
  lotId        String
  slotNumber   String // e.g., "A-10", "B-05"
  type         SlotType      @default(STANDARD)
  status       SlotStatus    @default(AVAILABLE)
  basePrice    Decimal       @db.Decimal(10, 2) // Support dynamic pricing updates
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  lot          ParkingLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([lotId, slotNumber]) // Prevents creating duplicate slots in the same lot
}

model Reservation {
  id           String            @id @default(uuid())
  userId       String
  lotId        String
  slotId       String
  startTime    DateTime // Arrival time
  endTime      DateTime // Expected checkout; pushed forward in place by auto-extensions
  totalPrice   Decimal           @db.Decimal(10, 2) // Estimated base charge (hourly rate x reserved hours), fixed at creation
  status       ReservationStatus @default(CONFIRMED)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  user         User              @relation(fields: [userId], references: [id])
  lot          ParkingLot        @relation(fields: [lotId], references: [id])
  slot         ParkingSlot       @relation(fields: [slotId], references: [id])
  payment      Payment?
  qrCodes      QrCode[]
  challans     Challan[]

  @@index([startTime, endTime, status]) // Critical for overlap/double-booking check queries
}

model Payment {
  id              String        @id @default(uuid())
  reservationId   String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique // References Stripe Sandbox transaction ID
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  // Relations
  reservation     Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model OccupancyLog {
  id            String     @id @default(uuid())
  lotId         String
  timestamp     DateTime   @default(now())
  occupiedSlots Int
  totalSlots    Int

  // Relations
  lot           ParkingLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, timestamp]) // Optimized for Analytics Dashboard timeline queries
}

model QrCode {
  id            String       @id @default(uuid())
  reservationId String
  type          QrCodeType
  token         String       @unique @default(uuid())
  status        QrCodeStatus @default(ACTIVE)
  expiresAt     DateTime? // null = no expiry (e.g. check-out codes: late exits must still work)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  // Relations
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, type])
}

// Append-only audit trail. Deliberately has no FK to User: audit rows must outlive/ignore
// changes to the entities they describe, and `userId` is null for system-initiated actions
// (e.g. the unpaid-reservation expiry sweep).
model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  metadata   Json?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// One challan per (reservation, type, forCheckoutAt): `forCheckoutAt` snapshots the
// `endTime` value the decision was made against, which both bills the correct amount and
// makes the monitoring cron's extend/overtime decision idempotent across repeated ticks.
model Challan {
  id            String      @id @default(uuid())
  reservationId String
  type          ChallanType
  amount        Decimal     @db.Decimal(10, 2)
  reason        String?
  forCheckoutAt DateTime
  createdAt     DateTime    @default(now())

  // Relations
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, type, forCheckoutAt])
  @@index([reservationId])
}

// Persisted in-app notification (no real email/SMS provider is wired up in this project —
// this is the "dummy" channel, structured so a real one can be swapped in later, same as
// the dummy payment flow). `forCheckoutAt` gives per-cycle reminders the same idempotency
// key used by Challan; nullable because one-off notifications (e.g. RESERVATION_CONFIRMED)
// don't belong to a checkout cycle.
model Notification {
  id            String                    @id @default(uuid())
  recipientId   String
  recipientRole NotificationRecipientRole
  reservationId String?
  type          String
  title         String
  message       String
  metadata      Json?
  forCheckoutAt DateTime?
  createdAt     DateTime                  @default(now())

  @@unique([recipientId, reservationId, type, forCheckoutAt])
  @@index([recipientId, createdAt])
}

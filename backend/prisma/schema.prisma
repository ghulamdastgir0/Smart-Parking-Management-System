datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  CUSTOMER
}

enum SlotType {
  STANDARD
  LARGE
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum ReservationStatus {
  CONFIRMED // Reservation made, no payment collected yet; check-in QR issued
  CHECKED_IN // Vehicle checked in; slot OCCUPIED
  OVERTIME // Grace period expired with another reservation queued; flagged for staff
  PENDING_PAYMENT // Checkout QR scanned, charge computed, awaiting dummy payment
  COMPLETED // Checkout payment succeeded; slot released
  CANCELLED // Auto-cancelled: no check-in within the check-in grace window
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum QrCodeType {
  CHECK_IN
  CHECK_OUT
}

enum QrCodeStatus {
  ACTIVE
  USED
  EXPIRED
}

enum ChallanType {
  EXTENSION // Automatic 1-hour extension because no other reservation is queued
  OVERTIME // Grace period expired while another reservation is queued for the slot
}

enum NotificationRecipientRole {
  USER
  MANAGER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique @db.VarChar(254)
  password     String // Bcrypt hash
  firstName    String        @db.VarChar(20)
  lastName     String        @db.VarChar(20)
  role         Role          @default(CUSTOMER)
  isBlocked    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  managedLots      ParkingLot[]     @relation("ManagerLots")
  reservations     Reservation[]
  paymentMethod    PaymentMethod?
  uploadedPolicies PolicyDocument[]

  @@index([email])
}

// Only the cardholder name, last 4 digits, expiry, and a cosmetic brand label are stored —
// never the full card number or CVV. Mirrors how real payment processors work: merchants
// never persist the full PAN/CVV, only a masked reference for display.
model PaymentMethod {
  id             String   @id @default(uuid())
  userId         String   @unique
  cardholderName String   @db.VarChar(100)
  brand          String   @db.VarChar(30)
  last4          String   @db.VarChar(4)
  expiryMonth    Int
  expiryYear     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParkingLot {
  id          String         @id @default(uuid())
  name        String         @db.VarChar(150)
  address     String         @db.VarChar(255)
  latitude    Float // For Leaflet / OpenStreetMap searches
  longitude   Float
  managerId   String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  manager       User           @relation("ManagerLots", fields: [managerId], references: [id])
  floors        ParkingFloor[]
  slots         ParkingSlot[]
  reservations  Reservation[]
  occupancyLogs OccupancyLog[]

  @@index([latitude, longitude]) // Fast geospatial bounds filtering
}

// A lot's parking layout is defined per floor — different floors commonly have different
// capacity (e.g. a smaller rooftop level vs a full basement), so rows/columns live here
// rather than on ParkingLot.
model ParkingFloor {
  id          String        @id @default(uuid())
  lotId       String
  name        String        @db.VarChar(50) // e.g., "Ground Floor", "Basement-1", "Floor-2"
  floorNumber Int // Sort/display order; also the uniqueness key within a lot
  rows        Int // Parking layout: number of row bands (A, B, C, ...) on this floor
  columns     Int // Parking layout: slots per row (1..columns) on this floor
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  lot   ParkingLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  slots ParkingSlot[]

  @@unique([lotId, floorNumber])
}

model ParkingSlot {
  id           String        @id @default(uuid())
  lotId        String // Denormalized from floor.lotId — keeps existing lot-scoped queries
  // (search, availability aggregation, nearby search) unchanged now that floor is the
  // direct parent.
  floorId      String
  slotNumber   String // e.g., "A-10", "B-05"
  type         SlotType      @default(STANDARD)
  status       SlotStatus    @default(AVAILABLE)
  restrictedReason String?   @db.VarChar(255) // Set when status -> MAINTENANCE, cleared on -> AVAILABLE
  basePrice    Decimal       @db.Decimal(10, 2) // Support dynamic pricing updates
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  lot          ParkingLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  floor        ParkingFloor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([floorId, slotNumber]) // Prevents duplicate slots on the same floor — slot
  // numbering restarts per floor (each floor's grid begins at "A1"), so uniqueness is
  // scoped to floor, not lot.
}

model Reservation {
  id           String            @id @default(uuid())
  userId       String
  lotId        String
  slotId       String
  startTime    DateTime // Arrival time
  endTime      DateTime // Expected checkout; pushed forward in place by auto-extensions
  totalPrice   Decimal           @db.Decimal(10, 2) // Estimated base charge (hourly rate x reserved hours), fixed at creation
  status       ReservationStatus @default(CONFIRMED)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lot          ParkingLot        @relation(fields: [lotId], references: [id])
  slot         ParkingSlot       @relation(fields: [slotId], references: [id])
  payment      Payment?
  qrCodes      QrCode[]
  challans     Challan[]

  @@index([startTime, endTime, status]) // Critical for overlap/double-booking check queries
}

model Payment {
  id              String        @id @default(uuid())
  reservationId   String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique // References Stripe Sandbox transaction ID
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  // Relations
  reservation     Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model OccupancyLog {
  id            String     @id @default(uuid())
  lotId         String
  timestamp     DateTime   @default(now())
  occupiedSlots Int
  totalSlots    Int

  // Relations
  lot           ParkingLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, timestamp]) // Optimized for Analytics Dashboard timeline queries
}

model QrCode {
  id            String       @id @default(uuid())
  reservationId String
  type          QrCodeType
  token         String       @unique @default(uuid())
  status        QrCodeStatus @default(ACTIVE)
  expiresAt     DateTime? // null = no expiry (e.g. check-out codes: late exits must still work)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  // Relations
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, type])
}

// Append-only audit trail. Deliberately has no FK to User: audit rows must outlive/ignore
// changes to the entities they describe, and `userId` is null for system-initiated actions
// (e.g. the unpaid-reservation expiry sweep).
model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  metadata   Json?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// One challan per (reservation, type, forCheckoutAt): `forCheckoutAt` snapshots the
// `endTime` value the decision was made against, which both bills the correct amount and
// makes the monitoring cron's extend/overtime decision idempotent across repeated ticks.
model Challan {
  id            String      @id @default(uuid())
  reservationId String
  type          ChallanType
  amount        Decimal     @db.Decimal(10, 2)
  reason        String?
  forCheckoutAt DateTime
  createdAt     DateTime    @default(now())

  // Relations
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, type, forCheckoutAt])
  @@index([reservationId])
}

// Admin-uploaded company policy document (PDF), split into embedded chunks so the AI
// assistant can answer policy questions grounded in the actual uploaded wording (RAG).
model PolicyDocument {
  id         String   @id @default(uuid())
  title      String   @db.VarChar(150)
  filename   String   @db.VarChar(255)
  uploadedBy String
  createdAt  DateTime @default(now())

  // Relations
  uploader User          @relation(fields: [uploadedBy], references: [id])
  chunks   PolicyChunk[]
}

// One row per ~800-character chunk of a PolicyDocument. `embedding` is a 384-dim vector
// from the local Xenova/all-MiniLM-L6-v2 model, stored as a plain float array — no pgvector
// extension required, since the corpus is small enough for brute-force cosine similarity.
model PolicyChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  chunkIndex Int
  embedding  Float[]
  createdAt  DateTime @default(now())

  // Relations
  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// Persisted in-app notification (no real email/SMS provider is wired up in this project —
// this is the "dummy" channel, structured so a real one can be swapped in later, same as
// the dummy payment flow). `forCheckoutAt` gives per-cycle reminders the same idempotency
// key used by Challan; nullable because one-off notifications (e.g. RESERVATION_CONFIRMED)
// don't belong to a checkout cycle.
model Notification {
  id            String                    @id @default(uuid())
  recipientId   String
  recipientRole NotificationRecipientRole
  reservationId String?
  type          String
  title         String
  message       String
  metadata      Json?
  forCheckoutAt DateTime?
  isRead        Boolean                   @default(false)
  createdAt     DateTime                  @default(now())

  @@unique([recipientId, reservationId, type, forCheckoutAt])
  @@index([recipientId, createdAt])
}
